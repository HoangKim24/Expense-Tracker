# Copy this file to .env and fill secrets. Do NOT commit .env

# Database
ConnectionStrings__DefaultConnection=Server=sql-server;Database=ExpenseTrackerDb;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;

# Encryption
Encryption__SecretKey=32-CHAR-SECRET-KEY-REPLACE_ME

# Telegram
Telegram__BotToken=BOT_TOKEN
Telegram__AuthorizedUserId=YOUR_TELEGRAM_ID

# Gmail Sync (MoMo & Cake)
Gmail__Email=your_email@gmail.com
Gmail__AppPassword=16_character_app_password
Gmail__LookbackDays=2
